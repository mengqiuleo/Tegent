{
  "name": "@tegent/cli",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tegent": "./bin/tegent.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "start": "node bin/tegent.js"
  },
  "dependencies": {
    "@tegent/core": "workspace:*"
  }
}
