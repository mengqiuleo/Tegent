{
  "name": "@tegent/cli",
  "version": "0.0.2",
  "type": "module",
  "author": {
    "name": "mengqiuleo"
  },
  "description": "运行在终端的 AI 助手",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mengqiuleo/Tegent",
    "directory": "packages/cli"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tegent": "./bin/tegent.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "start": "node bin/tegent.js",
    "prepack": "cp ../../README.md ./README.md",
    "postpack": "rm -f ./README.md"
  },
  "dependencies": {
    "@npmcli/disparity-colors": "^3.0.1",
    "@tegent/core": "workspace:*",
    "chalk": "^6.0.0",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/yargs": "^17.0.35"
  }
}
